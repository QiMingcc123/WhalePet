<Window x:Class="WhalePet.AlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="闹钟提醒"
        Width="820"
        Height="580"
        MinWidth="740"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="#081A32"
        Foreground="#EAF6FF"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentFill" Color="#0F8FD3FF"/>
        <SolidColorBrush x:Key="AccentBorder" Color="#4D8FD3FF"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CFEAFF"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F8FD3FF"/>
            <Setter Property="Foreground" Value="#EAF6FF"/>
            <Setter Property="BorderBrush" Value="#3D8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CaretBrush" Value="#EAF6FF"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CFEAFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#0F8FD3FF"/>
            <Setter Property="Foreground" Value="#CFEAFF"/>
            <Setter Property="BorderBrush" Value="#4D8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#358FD3FF"/>
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#8FD3FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#5A8FD3FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#4D6BFE"/>
            <Setter Property="BorderBrush" Value="#4D6BFE"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="闹钟提醒" FontSize="18" FontWeight="Bold" Foreground="#F3FAFF"/>
            <TextBlock Text="开始时间可输入 9、930、9:30 等写法，离开输入框会自动校正为 HH:mm；也可以点“选择日期时间…”按年、月、日、时、分选择。结束时间留空表示只在开始时提醒一次。"
                       Foreground="#7FA5C5" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,10">
            <ScrollViewer x:Name="AlarmScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AlarmList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="8"
                                    Background="{DynamicResource AccentFill}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Content="启用" IsChecked="{Binding Enabled}" Margin="0,0,14,0"/>
                                    <CheckBox Grid.Column="1" Content="每天" Margin="0,0,12,0"
                                              IsChecked="{Binding IsDaily}" ToolTip="勾选后每天重复，不勾选则只在所选日期提醒"/>
                                    <CheckBox Grid.Column="2" Content="弹窗" Margin="0,0,12,0"
                                              IsChecked="{Binding Popup}" ToolTip="提醒时同时弹出窗口"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DateDisplay}"
                                               Foreground="#8FD3FF" FontSize="11" VerticalAlignment="Center"
                                               MinWidth="94"/>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="选择日期时间…" Tag="{Binding}" Click="OnPickTime"
                                                Style="{StaticResource Action}"/>
                                        <Button Content="×" Tag="{Binding}" Click="OnDeleteAlarm"
                                                Style="{StaticResource Action}" Width="30" Height="28"
                                                FontSize="14" Padding="0" ToolTip="删除此闹钟"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1" Grid.ColumnSpan="5" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="开始" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="1" Width="66"
                                                 Text="{Binding Start, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="支持 9、930、9:30 等写法，离开后自动校正"/>
                                        <TextBlock Grid.Column="2" Text="—" VerticalAlignment="Center" Margin="8,0,8,0"/>
                                        <TextBox Grid.Column="3" Width="66"
                                                 Text="{Binding End, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="可留空；支持 9、930、9:30 等写法"/>
                                        <TextBlock Grid.Column="4" Text="（留空表示只提醒一次）"
                                                   Foreground="#6F8CA6" FontSize="9"
                                                   VerticalAlignment="Center" Margin="6,0,14,0"/>
                                        <TextBlock Grid.Column="5" Text="内容" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="6" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="提醒内容"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyHint" Text="还没有闹钟，点击下方“添加闹钟”。"
                       Foreground="#6F8CA6" FontSize="11" Margin="4,4,0,0"
                       TextWrapping="Wrap" IsHitTestVisible="False"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="＋ 添加闹钟" Style="{StaticResource Action}" Click="OnAddAlarm"/>
                <TextBlock x:Name="ErrorText" Foreground="#FFB4A8" FontSize="10"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="取消" Style="{StaticResource Action}" Click="OnCancel"/>
                <Button x:Name="SaveButton" Content="保存" Style="{StaticResource Primary}" Click="OnSave"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
