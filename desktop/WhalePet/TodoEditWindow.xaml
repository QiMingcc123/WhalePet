<Window x:Class="WhalePet.TodoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办事项"
        Width="430"
        Height="430"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="TodoCombo" TargetType="ComboBox" BasedOn="{StaticResource PetComboBox}">
            <Setter Property="Height" Value="30"/>
        </Style>
    </Window.Resources>
    <Border Background="#FF07182E" BorderBrush="#558FD3FF" BorderThickness="1" CornerRadius="14">
        <Grid Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Text="新增待办" FontSize="15" FontWeight="Bold"
                       Foreground="#F3FAFF"/>
            <TextBlock Grid.Row="1" Text="标题" Foreground="#9AB6CE" FontSize="10" Margin="0,12,0,3"/>
            <TextBox x:Name="TodoTitleBox" Grid.Row="2" Height="32" FontSize="12"
                     Background="#0F8FD3FF" Foreground="#EAF6FF" BorderBrush="#3D8FD3FF"
                     BorderThickness="1" Padding="7,4"/>
            <TextBlock Grid.Row="3" Text="备注（可选，参与搜索）" Foreground="#9AB6CE" FontSize="10"
                       Margin="0,10,0,3"/>
            <TextBox x:Name="TodoNotesBox" Grid.Row="4" Height="78" FontSize="11"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" Background="#0F8FD3FF" Foreground="#EAF6FF"
                     BorderBrush="#3D8FD3FF" BorderThickness="1" Padding="7,4"/>
            <Grid Grid.Row="5" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="紧急程度" Foreground="#9AB6CE" FontSize="10" Margin="0,0,0,3"/>
                        <ComboBox x:Name="UrgencyBox" Height="30" Style="{StaticResource TodoCombo}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Brush}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" Margin="7,0,0,0"
                                                   VerticalAlignment="Center" Foreground="#EAF6FF"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="状态" Foreground="#9AB6CE" FontSize="10" Margin="0,0,0,3"/>
                        <ComboBox x:Name="StatusBox" Height="30" Style="{StaticResource TodoCombo}"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" VerticalAlignment="Bottom" Margin="0,14,0,0">
                    <TextBlock x:Name="ErrorText" Foreground="#FF9A9A" FontSize="10"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Width="70" Height="30" Margin="0,0,8,0"
                                Background="#1F8FD3FF" Foreground="#DFF2FF" BorderBrush="#5A8FD3FF"
                                BorderThickness="1" Click="OnCancelClick"/>
                        <Button Content="保存" Width="70" Height="30"
                                Background="#4D6BFE" Foreground="#FFFFFF" BorderBrush="#7E93FF"
                                BorderThickness="1" Click="OnSaveClick"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
