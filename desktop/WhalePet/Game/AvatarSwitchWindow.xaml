<Window x:Class="WhalePet.Game.AvatarSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="切换形象"
        Width="760"
        Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        Focusable="True"
        KeyDown="OnKeyDown"
        Loaded="OnLoaded"
        Closed="OnClosed">
    <Window.Resources>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#1F8FD3FF"/>
            <Setter Property="Foreground" Value="#DFF2FF"/>
            <Setter Property="BorderBrush" Value="#5A8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#4D6BFE"/>
            <Setter Property="BorderBrush" Value="#7E93FF"/>
            <Setter Property="Padding" Value="22,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SwitchTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#9AB6CE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="8"
                                Padding="16,8" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#2E8FD3FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1C8FD3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="#FF07182E" BorderBrush="#558FD3FF" BorderThickness="1">
        <Grid Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="OnHeaderDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2E8FD3FF" CornerRadius="10" Padding="8,2">
                        <TextBlock Text="鲸" FontSize="14" FontWeight="Bold" Foreground="#8FD3FF"/>
                    </Border>
                    <TextBlock Text="切换形象" FontSize="15" FontWeight="Bold" Foreground="#F3FAFF" Margin="8,0,0,0"/>
                    <Border Background="#248FD3FF" CornerRadius="8" Padding="7,2" Margin="10,0,0,0">
                        <TextBlock Text="Ctrl+Alt+G" FontSize="9" Foreground="#CFEAFF"/>
                    </Border>
                </StackPanel>
                <Button Style="{StaticResource Action}" Content="✕" Width="30" Height="28" Padding="0"
                        FontSize="14" HorizontalAlignment="Right" Click="OnCloseClick"/>
            </Grid>

            <TabControl x:Name="SwitchTabs" Grid.Row="1" Margin="0,14,0,10"
                        Background="Transparent" BorderThickness="0"
                        SelectionChanged="OnTabChanged">
                <TabItem Header="默认主形象" Style="{StaticResource SwitchTab}">
                    <Border Background="#140E2C4C" BorderBrush="#2C5B84" BorderThickness="1"
                            CornerRadius="12" Padding="12,10" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="DefaultPanel" Orientation="Horizontal"/>
                            </ScrollViewer>
                            <TextBlock x:Name="DefaultHintText" Grid.Row="1" FontSize="9.5"
                                       Foreground="#7FA5C5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="动态图" Style="{StaticResource SwitchTab}">
                    <Border Background="#140E2C4C" BorderBrush="#2C5B84" BorderThickness="1"
                            CornerRadius="12" Padding="12,10" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="DynamicPanel" Orientation="Horizontal"/>
                            </ScrollViewer>
                            <TextBlock x:Name="DynamicHintText" Grid.Row="1" FontSize="9.5"
                                       Foreground="#7FA5C5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="Live2D" Style="{StaticResource SwitchTab}">
                    <Border Background="#140E2C4C" BorderBrush="#2C5B84" BorderThickness="1"
                            CornerRadius="12" Padding="12,10" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="Live2DPanel" Orientation="Horizontal"/>
                            </ScrollViewer>
                            <TextBlock x:Name="Live2DHintText" Grid.Row="1" FontSize="9.5"
                                       Foreground="#7FA5C5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="2">
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="CaptionText" FontSize="12" Foreground="#EAF6FF"/>
                    <TextBlock x:Name="CounterText" FontSize="10" Foreground="#7FA5C5"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Action}" Content="取消" Click="OnCancelClick"/>
                    <Button x:Name="ApplyButton" Style="{StaticResource Primary}" Content="退出并应用"
                            Click="OnApplyClick" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
