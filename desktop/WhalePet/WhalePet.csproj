<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WhalePet</AssemblyName>
    <RootNamespace>WhalePet</RootNamespace>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" Exclude="Assets\gifs.enc;Assets\gifs.manifest.json" />
    <EmbeddedResource Include="Assets\gifs.enc" LogicalName="WhalePet.Resources.gifs.enc" />
    <EmbeddedResource Include="Assets\gifs.manifest.json" LogicalName="WhalePet.Resources.gifs.manifest.json" />
    <EmbeddedResource Include="..\..\img\resources\ingredients\fish.png" LogicalName="WhalePet.Resources.img.ingredients.fish.png" />
    <EmbeddedResource Include="..\..\img\resources\food\fish_meat.png" LogicalName="WhalePet.Resources.img.food.fish_meat.png" />
    <EmbeddedResource Include="..\..\img\resources\food\sushi.png" LogicalName="WhalePet.Resources.img.food.sushi.png" />
    <EmbeddedResource Include="..\..\txt\LotMessage.txt" LogicalName="WhalePet.Resources.txt.LotMessage.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\Live2DWeb\**\*"
             Exclude="..\..\Live2DWeb\models\seethrough_output\seethrough_output.4096\**\*">
      <Link>Live2DWeb\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\Live2DWeb\models\seethrough_output\seethrough_output.4096\*.png">
      <Link>Live2DWeb\models\seethrough_output\seethrough_output.4096\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyLive2DTextures" AfterTargets="Build">
    <ItemGroup>
      <Live2DTexture Include="$(MSBuildProjectDirectory)\..\..\Live2DWeb\models\seethrough_output\seethrough_output.4096\*.png" />
      <Live2DModelFile Include="$(MSBuildProjectDirectory)\..\..\Live2DWeb\models\seethrough_output\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(Live2DTexture)"
          DestinationFolder="$(OutDir)Live2DWeb\models\seethrough_output\seethrough_output.4096" />
    <Copy SourceFiles="@(Live2DModelFile)"
          DestinationFolder="$(OutDir)Live2DWeb\models\seethrough_output" />
  </Target>

  <Target Name="CopyLive2DTexturesPublish" AfterTargets="Publish">
    <ItemGroup>
      <Live2DTexturePublish Include="$(MSBuildProjectDirectory)\..\..\Live2DWeb\models\seethrough_output\seethrough_output.4096\*.png" />
      <Live2DModelFilePublish Include="$(MSBuildProjectDirectory)\..\..\Live2DWeb\models\seethrough_output\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(Live2DTexturePublish)"
          DestinationFolder="$(PublishDir)Live2DWeb\models\seethrough_output\seethrough_output.4096" />
    <Copy SourceFiles="@(Live2DModelFilePublish)"
          DestinationFolder="$(PublishDir)Live2DWeb\models\seethrough_output" />
  </Target>
</Project>
