<Window x:Class="WhalePet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鲸鱼娘"
        Width="470"
        SizeToContent="Height"
        MaxHeight="1200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="OnLoaded"
        SizeChanged="OnSizeChanged"
        MouseLeave="OnWindowMouseLeave"
        Closing="OnClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#EAF6FF"/>
        <SolidColorBrush x:Key="Muted" Color="#9AB6CE"/>
        <SolidColorBrush x:Key="Faint" Color="#6F8CA6"/>
        <SolidColorBrush x:Key="Accent" Color="#8FD3FF"/>
        <SolidColorBrush x:Key="Deep" Color="#081A32"/>
        <SolidColorBrush x:Key="Deep2" Color="#061226"/>
        <SolidColorBrush x:Key="Line" Color="#3A6C95"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#B30A1E38"/>
            <Setter Property="Foreground" Value="#CFEAFF"/>
            <Setter Property="BorderBrush" Value="#6B8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D91A3A62"/>
                                <Setter Property="BorderBrush" Value="#CC8FD3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Background" Value="#0F8FD3FF"/>
            <Setter Property="Foreground" Value="#CFEAFF"/>
            <Setter Property="BorderBrush" Value="#4D8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#248FD3FF"/>
                                <Setter Property="BorderBrush" Value="#998FD3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <SolidColorBrush x:Key="MenuBackground" Color="#F2081A32"/>
        <SolidColorBrush x:Key="MenuBorder" Color="#4D8FD3FF"/>
        <SolidColorBrush x:Key="MenuForeground" Color="#DFF2FF"/>
        <SolidColorBrush x:Key="MenuHover" Color="#248FD3FF"/>
        <SolidColorBrush x:Key="MenuSeparator" Color="#2A8FD3FF"/>

        <Style x:Key="PetContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource MenuBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuForeground}"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.4" Color="#000714"/>
                            </Border.Effect>
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PetMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource MenuForeground}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Surface"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource MenuHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PetSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource MenuSeparator}" Margin="8,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SummaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F2091B36"/>
            <Setter Property="BorderBrush" Value="#478FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#998FD3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot" Background="Transparent">
    <Grid x:Name="Root" Background="Transparent" Margin="0">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.ContextMenu>
            <ContextMenu Style="{StaticResource PetContextMenu}">
                <MenuItem Style="{StaticResource PetMenuItem}" Header="备忘录..." Click="OnMemoClick"/>
                <MenuItem Style="{StaticResource PetMenuItem}" Header="设置..." Click="OnSettingsClick"/>
                <MenuItem x:Name="AlarmMenuItem" Style="{StaticResource PetMenuItem}" Header="闹钟提醒..." Click="OnAlarmsClick"/>
                <MenuItem x:Name="ClipboardMenuItem" Style="{StaticResource PetMenuItem}" Header="剪贴板历史..." Click="OnClipboardHistoryClick"/>
                <MenuItem x:Name="ScreenshotMenuItem" Style="{StaticResource PetMenuItem}" Header="截图..." Click="OnScreenshotClick"/>
                <MenuItem x:Name="LockMenuItem" Style="{StaticResource PetMenuItem}" Header="锁屏" Click="OnLockScreenClick"/>
                <MenuItem Style="{StaticResource PetMenuItem}" Header="显示 / 隐藏状态栏" Click="OnToggleStatusClick"/>
                <MenuItem Style="{StaticResource PetMenuItem}" Header="重置到右下角" Click="OnResetPositionClick"/>
                <Separator Style="{StaticResource PetSeparator}"/>
                <MenuItem Style="{StaticResource PetMenuItem}" Header="退出" Click="OnExitClick"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="WeatherPill"
                Grid.Row="0"
                HorizontalAlignment="Center"
                Margin="0,0,0,2"
                Padding="10,5"
                CornerRadius="11"
                Background="#D9081A32"
                BorderBrush="#4D8FD3FF"
                BorderThickness="1"
                Visibility="Collapsed">
            <TextBlock x:Name="WeatherText"
                       Foreground="#DCEFFF"
                       FontSize="10.5"
                       FontWeight="SemiBold"/>
        </Border>

        <Border x:Name="SpeechBubble"
                Grid.Row="1"
                Panel.ZIndex="20"
                HorizontalAlignment="Center"
                Margin="0,2,0,0"
                Padding="11,8"
                MaxWidth="310"
                CornerRadius="13,13,4,13"
                Background="#FFF8EA"
                BorderBrush="#330B1B3A"
                BorderThickness="1"
                Visibility="Collapsed"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="SpeechBubbleScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3" Color="#000714"/>
            </Border.Effect>
            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="SpeechText"
                           Foreground="#0B1B3A"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <Grid x:Name="CharacterHost"
              Grid.Row="2"
              Panel.ZIndex="0"
              Width="430"
              Height="400"
              Background="Transparent"
              Cursor="Hand"
              RenderTransformOrigin="0.5,0.9"
              MouseLeftButtonDown="OnCharacterMouseDown"
              MouseLeftButtonUp="OnCharacterMouseUp"
              MouseMove="OnCharacterMouseMove"
              MouseLeave="OnCharacterMouseLeave">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="CharacterLayoutScale" ScaleX="1" ScaleY="1"/>
            </Grid.LayoutTransform>
            <Grid.RenderTransform>
                <ScaleTransform x:Name="CharacterPressScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <Image x:Name="BackImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Image x:Name="FrontImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.34" Color="#000714"/>
                </Image.Effect>
            </Image>

            <Canvas x:Name="PointerLayer" Width="430" Height="400" IsHitTestVisible="False" ClipToBounds="True">
                <TextBlock x:Name="PointerGlyph"
                           Text="↖"
                           Foreground="#FFB35C"
                           FontSize="20"
                           FontWeight="Bold"
                           Visibility="Collapsed"/>
            </Canvas>

        </Grid>

        <Grid x:Name="ControlLayer"
              Grid.Row="2"
              HorizontalAlignment="Center"
              VerticalAlignment="Top">
            <Border x:Name="InputBadge"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="8,8,0,0"
                    Padding="7,4"
                    CornerRadius="8"
                    Background="#C4091B36"
                    BorderBrush="#6B8FD3FF"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"
                    RenderTransformOrigin="0,0">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="InputBadgeScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="InputIcon" Text="⌨" Foreground="#DCEFFF" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="InputText" Text="键盘输入" Foreground="#DCEFFF" FontSize="9" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel x:Name="KeycapPanel" Orientation="Horizontal" Margin="5,0,0,0" Visibility="Collapsed">
                        <Border Width="14" Height="14" Margin="0,0,2,0" CornerRadius="3" Background="#248FD3FF" BorderBrush="#668FD3FF" BorderThickness="1">
                            <TextBlock Text="A" FontSize="7" Foreground="#CFEAFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="14" Height="14" Margin="0,0,2,0" CornerRadius="3" Background="#248FD3FF" BorderBrush="#668FD3FF" BorderThickness="1">
                            <TextBlock Text="B" FontSize="7" Foreground="#CFEAFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="14" Height="14" CornerRadius="3" Background="#248FD3FF" BorderBrush="#668FD3FF" BorderThickness="1">
                            <TextBlock Text="C" FontSize="7" Foreground="#CFEAFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button x:Name="GearButton"
                    Style="{StaticResource IconButton}"
                    Content="⚙"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,8,0"
                    ToolTip="设置"
                    Click="OnSettingsClick"
                    RenderTransformOrigin="1,0">
                <Button.RenderTransform>
                    <ScaleTransform x:Name="SettingsButtonScale" ScaleX="1" ScaleY="1"/>
                </Button.RenderTransform>
            </Button>
            <Border x:Name="WorkBadge"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="2,104,0,0"
                    MaxWidth="180"
                    Padding="7,5"
                    CornerRadius="9"
                    Background="#F2FFF8EA"
                    BorderBrush="#668FD3FF"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="WorkBadgeScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="WorkBadgeText"
                               Text="搬砖中..."
                               Foreground="#0B1B3A"
                               FontSize="10"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <Button x:Name="SummaryButton"
                Grid.Row="3"
                Width="430"
                MinHeight="38"
                Margin="0,-26,0,0"
                Style="{StaticResource SummaryButton}"
                Click="OnSummaryClick">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot"
                         Width="6"
                         Height="6"
                         Fill="#58E0B4"
                         Margin="0,0,7,0"
                         VerticalAlignment="Center"/>
                <ScrollViewer x:Name="StatusTextScroll"
                              Grid.Column="1"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Hidden"
                              Focusable="False"
                              PanningMode="HorizontalOnly"
                              VerticalAlignment="Center"
                              MouseEnter="OnStatusTextMouseEnter"
                              MouseLeave="OnStatusTextMouseLeave">
                    <TextBlock x:Name="SummaryText"
                               Foreground="#EAF6FF"
                               FontSize="10.5"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               Text="鲸鱼娘 · 正在加载…"/>
                </ScrollViewer>
                <TextBlock x:Name="SummaryChevron"
                           Grid.Column="2"
                           Foreground="#7FA5C5"
                           FontSize="10"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Text="▾"/>
            </Grid>
        </Button>

        <StackPanel x:Name="StatusActions"
                    Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="0,-26,0,0"
                    Panel.ZIndex="2">
            <Button x:Name="LockStatusButton"
                    Style="{StaticResource IconButton}"
                    Content="🔒"
                    ToolTip="一键锁屏"
                    Visibility="Collapsed"
                    Click="OnLockScreenClick"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0"/>
            <Button x:Name="UsbButton"
                    Style="{StaticResource IconButton}"
                    Content="🔌"
                    ToolTip="移动设备"
                    Visibility="Collapsed"
                    Click="OnUsbClick"
                    MouseRightButtonUp="OnUsbRightClick"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0"/>
        </StackPanel>

        <Border x:Name="DetailsPanel"
                Grid.Row="4"
                Width="430"
                Margin="0,2,0,0"
                Padding="12,10"
                CornerRadius="12"
                Background="#F2081A32"
                BorderBrush="#3D8FD3FF"
                BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="功能" Foreground="#8FD3FF" FontSize="9" FontWeight="Bold"/>
                <WrapPanel Margin="0,5,0,6">
                    <Button Style="{StaticResource SmallButton}" Content="备忘录" Click="OnMemoClick"/>
                    <Button Style="{StaticResource SmallButton}" Content="设置" Click="OnSettingsClick"/>
                    <Button Style="{StaticResource SmallButton}" Content="天气" Click="OnRefreshWeatherClick"/>
                    <Button x:Name="AlarmButton" Style="{StaticResource SmallButton}" Content="闹钟"
                            Click="OnAlarmsClick" Visibility="Collapsed"/>
                    <Button x:Name="ClipboardHistoryButton" Style="{StaticResource SmallButton}" Content="剪贴板"
                            Click="OnClipboardHistoryClick" Visibility="Collapsed"/>
                    <Button x:Name="ScreenshotButton" Style="{StaticResource SmallButton}" Content="截图"
                            Click="OnScreenshotClick" Visibility="Collapsed"/>
                    <Button x:Name="LockScreenButton" Style="{StaticResource SmallButton}" Content="锁屏"
                            Click="OnLockScreenClick" Visibility="Collapsed"/>
                </WrapPanel>
                <Border Height="1" Background="#1F8FD3FF" Margin="0,0,0,6"/>
                <ScrollViewer x:Name="DetailsScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="210">
                    <StackPanel>
                        <TextBlock Text="桌面状态" Foreground="#DFF2FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                        <TextBlock x:Name="ClockText" Foreground="#CFEAFF" FontSize="10" Margin="0,0,0,3"/>
                        <TextBlock x:Name="StateText" Foreground="#9AB6CE" FontSize="9.5" TextWrapping="Wrap" Margin="0,0,0,2"/>
                        <TextBlock x:Name="IdleText" Foreground="#9AB6CE" FontSize="9.5" TextWrapping="Wrap" Margin="0,0,0,2"/>
                        <TextBlock x:Name="WeatherDetailText"
                                   Foreground="#9AB6CE"
                                   FontSize="9.5"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,4"/>
                        <StackPanel x:Name="DeviceInfoPanel" Visibility="Collapsed" Margin="0,2,0,5">
                            <TextBlock Text="设备信息" Foreground="#DFF2FF" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBlock x:Name="DeviceMemoryText" Foreground="#9AB6CE" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <TextBlock x:Name="DeviceCpuText" Foreground="#9AB6CE" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <TextBlock x:Name="DeviceGpuText" Foreground="#9AB6CE" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <TextBlock x:Name="DeviceDiskText" Foreground="#9AB6CE" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <TextBlock x:Name="DeviceNetworkText" Foreground="#9AB6CE" FontSize="9" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock x:Name="ConfigText"
                                   Foreground="#6F8CA6"
                                   FontSize="8.5"
                                   TextWrapping="Wrap"
                                   Cursor="Hand"
                                   ToolTipService.ShowDuration="20000"
                                   MouseLeftButtonUp="OnConfigPathClick"
                                   MouseRightButtonUp="OnConfigPathRightClick"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource SmallButton}" Content="重置位置" Click="OnResetPositionClick"/>
                            <Button Style="{StaticResource SmallButton}" Content="退出" Click="OnExitClick"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>

    <Border x:Name="CollapsedTab"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            CornerRadius="8"
            Background="#F2091B36"
            BorderBrush="#6B8FD3FF"
            BorderThickness="1"
            Cursor="Hand"
            MouseEnter="OnCollapsedTabMouseEnter">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="🐳" Foreground="#9FD8FF" FontSize="18" HorizontalAlignment="Center"/>
            <TextBlock x:Name="CollapsedHint" Text="▶" Foreground="#9FD8FF" FontSize="9"
                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>
    </Border>
    </Grid>
</Window>
