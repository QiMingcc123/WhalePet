<Window x:Class="WhalePet.TodoDateRangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择日期范围"
        Width="430"
        Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="#0F2238"/>
            <Setter Property="Foreground" Value="#EAF6FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Calendar">
            <Setter Property="Background" Value="#0F2238"/>
            <Setter Property="Foreground" Value="#EAF6FF"/>
            <Setter Property="BorderBrush" Value="#4D8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1F8FD3FF"/>
            <Setter Property="Foreground" Value="#DFF2FF"/>
            <Setter Property="BorderBrush" Value="#5A8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>
    </Window.Resources>
    <Border Background="#F2081A32" BorderBrush="#558FD3FF" BorderThickness="1" CornerRadius="14">
        <Grid Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="自定义日期范围" FontSize="15" FontWeight="Bold" Foreground="#F3FAFF"/>
            <TextBlock Grid.Row="1" Text="起始日期" Foreground="#9AB6CE" FontSize="10" Margin="0,14,0,4"/>
            <DatePicker x:Name="StartDatePicker" Grid.Row="2" Style="{StaticResource PetDatePicker}"
                        SelectedDateFormat="Short"/>
            <TextBlock Grid.Row="3" Text="结束日期" Foreground="#9AB6CE" FontSize="10" Margin="0,12,0,4"/>
            <DatePicker x:Name="EndDatePicker" Grid.Row="4" VerticalAlignment="Top"
                        Style="{StaticResource PetDatePicker}" SelectedDateFormat="Short"/>
            <Grid Grid.Row="4" VerticalAlignment="Bottom" Margin="0,74,0,0">
                <TextBlock x:Name="ErrorText" Foreground="#FF9A9A" FontSize="10"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="清除自定义" Style="{StaticResource Action}" Margin="0,0,8,0"
                            Click="OnClearClick"/>
                    <Button Content="取消" Style="{StaticResource Action}" Margin="0,0,8,0"
                            Click="OnCancelClick"/>
                    <Button Content="确定" Background="#4D6BFE" Foreground="#FFFFFF"
                            BorderBrush="#7E93FF" Style="{StaticResource Action}"
                            Click="OnOkClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
