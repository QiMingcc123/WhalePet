<Window x:Class="WhalePet.Game.GifPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:game="clr-namespace:WhalePet.Game"
        Title="动态图预览"
        Width="1040"
        Height="820"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI"
        KeyDown="OnKeyDown"
        Loaded="OnLoaded"
        Closed="OnClosed">
    <Border CornerRadius="16" Background="#FA07182E" BorderBrush="#6B8FD3FF" BorderThickness="1">
        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2E8FD3FF" CornerRadius="8" Padding="7,1">
                        <TextBlock Text="图" FontSize="13" FontWeight="Bold" Foreground="#8FD3FF"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Text="动态图预览" FontSize="14" FontWeight="Bold"
                               Foreground="#F3FAFF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SourceText" FontSize="10" Foreground="#8FD3FF"
                               Margin="10,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" Width="30" Height="28" HorizontalAlignment="Right"
                        Click="OnCloseClick" FontSize="14" Foreground="#DFF2FF"
                        Background="#1F8FD3FF" BorderBrush="#5A8FD3FF" BorderThickness="1"
                        Cursor="Hand"/>
            </Grid>

            <Border Grid.Row="1" Margin="0,10,0,8" CornerRadius="10" Background="#030E1E"
                    BorderBrush="#2C5B84" BorderThickness="1" ClipToBounds="True">
                <Grid x:Name="Viewport" Background="#030E1E"
                      MouseWheel="OnMouseWheel" MouseLeftButtonDown="OnViewportMouseDown">
                    <Canvas x:Name="ImageCanvas" ClipToBounds="True" Background="Transparent">
                        <Border x:Name="ImageHit" Width="100" Height="100" Background="Transparent"
                                RenderTransformOrigin="0,0" Cursor="Hand"
                                MouseLeftButtonDown="OnImageMouseDown">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="ImageOffset" X="0" Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <game:GifPlayerControl x:Name="PreviewGif"/>
                        </Border>
                    </Canvas>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <TextBlock x:Name="ZoomText" FontSize="10" Foreground="#8FD3FF" VerticalAlignment="Center"/>
                <TextBlock Text="滚轮缩放 50%–400% · Esc / 点击空白 / 关闭按钮退出"
                           FontSize="9.5" Foreground="#6F8CA6" HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
