<Window x:Class="WhalePet.ScreenshotEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图编辑"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#081A32"
        Foreground="#EAF6FF"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CFEAFF"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F8FD3FF"/>
            <Setter Property="Foreground" Value="#EAF6FF"/>
            <Setter Property="BorderBrush" Value="#3D8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CaretBrush" Value="#EAF6FF"/>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#148FD3FF"/>
            <Setter Property="Foreground" Value="#CFEAFF"/>
            <Setter Property="BorderBrush" Value="#4D8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#358FD3FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="ToolbarBorder" Padding="12,8" Background="#0B2038" BorderBrush="#2A5A80" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="工具" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="SelectToolButton" Content="选择" Style="{StaticResource ToolButton}" Click="OnToolClick" Tag="select"/>
                <Button x:Name="TextToolButton" Content="文字" Style="{StaticResource ToolButton}" Click="OnToolClick" Tag="text"/>
                <Button x:Name="LineToolButton" Content="直线" Style="{StaticResource ToolButton}" Click="OnToolClick" Tag="line"/>
                <Button x:Name="ArrowToolButton" Content="箭头" Style="{StaticResource ToolButton}" Click="OnToolClick" Tag="arrow"/>
                <Button x:Name="RectToolButton" Content="方框" Style="{StaticResource ToolButton}" Click="OnToolClick" Tag="rect"/>
                <Border Width="1" Background="#2A5A80" Margin="6,2,10,2"/>
                <Button x:Name="ColorButton" Content="颜色" Style="{StaticResource ToolButton}" Click="OnPickColor"/>
                <TextBlock Text="线宽" VerticalAlignment="Center" Margin="2,0,6,0"/>
                <TextBox x:Name="ThicknessBox" Width="44" Text="3" MaxLength="2" Margin="0,0,10,0"/>
                <Button Content="撤销" Style="{StaticResource ToolButton}" Click="OnUndo"/>
                <Button Content="清空" Style="{StaticResource ToolButton}" Click="OnClear"/>
                <Border Width="1" Background="#2A5A80" Margin="6,2,10,2"/>
                <Button x:Name="SaveButton" Content="保存到设备" Style="{StaticResource ToolButton}" Click="OnSave"
                        Background="#4D6BFE" BorderBrush="#4D6BFE" Foreground="#FFFFFF"/>
                <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                      Background="#060F1C">
            <Canvas x:Name="EditorCanvas" Background="#0A1628"
                    MouseLeftButtonDown="OnCanvasMouseDown"
                    MouseMove="OnCanvasMouseMove"
                    MouseLeftButtonUp="OnCanvasMouseUp"/>
        </ScrollViewer>

        <Border x:Name="FooterBorder" Grid.Row="2" Padding="12,6" Background="#0B2038" BorderBrush="#2A5A80" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="选择工具后在截图上拖动；文字工具点击后输入。"/>
        </Border>
    </Grid>
</Window>
