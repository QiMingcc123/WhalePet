<Window x:Class="WhalePet.Game.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卸载桌宠"
        Width="560"
        Height="430"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#1F8FD3FF"/>
            <Setter Property="Foreground" Value="#DFF2FF"/>
            <Setter Property="BorderBrush" Value="#5A8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#55C0392B"/>
            <Setter Property="BorderBrush" Value="#AAFF8A8A"/>
            <Setter Property="Foreground" Value="#FFE1E1"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CFEAFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#F507182E" BorderBrush="#88FF8A8A" BorderThickness="1">
        <Grid Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="卸载桌宠" FontSize="17" FontWeight="Bold" Foreground="#FFC9C9"/>
                <TextBlock Text="选择是否保留本机用户数据。默认保留，之后重新安装可以继续使用。"
                           FontSize="10.5" Foreground="#FFB0B0" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,10">
                <StackPanel>
                    <Border Background="#160E2C4C" CornerRadius="10" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="用户数据包括" FontSize="10.5" FontWeight="Bold" Foreground="#FFD7D7"/>
                            <TextBlock FontSize="10" Foreground="#E8B8B8" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="角色面板与游戏数据、默认/自定义主形象、动态图启用状态、备忘录、剪贴板历史、桌面待办与图标收纳、设置配置、闹钟提醒、阅读区域配置等。"/>
                        </StackPanel>
                    </Border>

                    <RadioButton x:Name="KeepDataRadio" GroupName="UninstallData"
                                 Content="保留用户数据（推荐，默认）" IsChecked="True"
                                 Checked="OnDataChoiceChanged"/>
                    <RadioButton x:Name="ClearDataRadio" GroupName="UninstallData"
                                 Content="清空所有桌宠相关数据" Checked="OnDataChoiceChanged"/>
                    <TextBlock x:Name="ClearHint" FontSize="9.5" Foreground="#FF9A9A" TextWrapping="Wrap"
                               Margin="22,4,0,0" Visibility="Collapsed"
                               Text="将删除设置、游戏角色面板数据、备忘录、剪贴板、待办、收纳区、角色形象、闹钟、激活绑定与所有备份。此操作不可逆。"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Action}" Content="取消" Click="OnCancelClick"/>
                <Button x:Name="UninstallButton" Style="{StaticResource Danger}" Content="卸载"
                        Click="OnConfirmClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
