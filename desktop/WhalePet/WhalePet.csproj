<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WhalePet</AssemblyName>
    <RootNamespace>WhalePet</RootNamespace>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" Exclude="Assets\gifs.enc;Assets\gifs.manifest.json" />
    <EmbeddedResource Include="Assets\gifs.enc" LogicalName="WhalePet.Resources.gifs.enc" />
    <EmbeddedResource Include="Assets\gifs.manifest.json" LogicalName="WhalePet.Resources.gifs.manifest.json" />
    <EmbeddedResource Include="..\..\img\resources\ingredients\fish.png" LogicalName="WhalePet.Resources.img.ingredients.fish.png" />
    <EmbeddedResource Include="..\..\img\resources\food\fish_meat.png" LogicalName="WhalePet.Resources.img.food.fish_meat.png" />
    <EmbeddedResource Include="..\..\img\resources\food\sushi.png" LogicalName="WhalePet.Resources.img.food.sushi.png" />
    <EmbeddedResource Include="..\..\txt\LotMessage.txt" LogicalName="WhalePet.Resources.txt.LotMessage.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
</Project>
