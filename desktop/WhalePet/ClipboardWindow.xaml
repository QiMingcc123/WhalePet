<Window x:Class="WhalePet.ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剪贴板历史"
        Width="620"
        Height="580"
        MinWidth="500"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#081A32"
        Foreground="#EAF6FF"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentFill" Color="#0F8FD3FF"/>
        <SolidColorBrush x:Key="AccentBorder" Color="#4D8FD3FF"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CFEAFF"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
            <Setter Property="Foreground" Value="#CFEAFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#5A8FD3FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="剪贴板历史" FontSize="18" FontWeight="Bold" Foreground="#F3FAFF"/>
            <TextBlock Text="只记录文本内容，保存在本机，最多 50 条。点击“复制”可重新放回剪贴板。"
                       Foreground="#7FA5C5" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="EntryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="8"
                                    Background="{DynamicResource AccentFill}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="96"
                                                   FontSize="11" Foreground="#EAF6FF"/>
                                        <TextBlock Text="{Binding CreatedAtDisplay}" FontSize="9"
                                                   Foreground="#7FA5C5" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Top" Margin="10,0,0,0">
                                        <Button Content="复制" Tag="{Binding}" Click="OnCopyEntry" Style="{StaticResource Action}"/>
                                        <Button Content="×" Tag="{Binding}" Click="OnDeleteEntry"
                                                Style="{StaticResource Action}" Width="30" Padding="0"
                                                FontSize="14" ToolTip="删除这一条"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyHint" Text="还没有记录。复制一段文字后，这里会出现历史。"
                       Foreground="#6F8CA6" FontSize="11" Margin="4,4,0,0"
                       TextWrapping="Wrap" IsHitTestVisible="False"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="#7FA5C5" FontSize="10" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="清空全部" Style="{StaticResource Action}" Click="OnClearAll"/>
                <Button Content="关闭" Style="{StaticResource Action}" Click="OnClose"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
