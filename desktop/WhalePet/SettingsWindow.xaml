<Window x:Class="WhalePet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhalePet"
        Title="鲸鱼娘桌宠设置"
        Width="840"
        Height="800"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=ShowStatusCheck}"
        Background="#081A32"
        Foreground="#EAF6FF"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CFEAFF"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F8FD3FF"/>
            <Setter Property="Foreground" Value="#081A32"/>
            <Setter Property="BorderBrush" Value="#3D8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CaretBrush" Value="#EAF6FF"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CFEAFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#081A32"/>
            <Setter Property="BorderBrush" Value="#3D8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#081A32"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FD3FF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AB6CE"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,5,0,2"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="ToolTipService.Placement" Value="Top"/>
            <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#0F8FD3FF"/>
            <Setter Property="Foreground" Value="#CFEAFF"/>
            <Setter Property="BorderBrush" Value="#4D8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#5A8FD3FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#4D6BFE"/>
            <Setter Property="BorderBrush" Value="#4D6BFE"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Button x:Name="TocButton" Content="目录" Style="{StaticResource Action}"
                    Width="58" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Click="OnToggleToc"/>
            <StackPanel Margin="70,0,0,0">
                <TextBlock Text="鲸鱼娘桌宠设置" FontSize="18" FontWeight="Bold" Foreground="#F3FAFF"/>
                <TextBlock Text="修改后会立即应用到桌面宠物，并保存到本机配置。"
                           Foreground="#7FA5C5" FontSize="10" Margin="0,4,0,0"/>
                <Border x:Name="NoticeBubble"
                        Margin="0,10,0,0"
                        Padding="10,8"
                        CornerRadius="12,12,4,12"
                        Background="#FFF8EA"
                        BorderBrush="#330B1B3A"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText"
                               Foreground="#8A2E2E"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TocColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="TocPanel" Grid.Column="0" Width="170" Visibility="Collapsed"
                    Background="#140E2C4C" BorderBrush="#2C5B84" BorderThickness="1"
                    CornerRadius="10" Padding="8,8" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TocItemsPanel"/>
                </ScrollViewer>
            </Border>
            <ScrollViewer x:Name="SettingsScroll" Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          ScrollChanged="OnSettingsScrollChanged">
                <StackPanel x:Name="SettingsContent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,0,0">
                <TextBlock x:Name="BasicSectionTitle" Text="基础" Style="{StaticResource Section}"/>
                <CheckBox x:Name="ShowStatusCheck" Content="显示数据状态栏"/>
                <CheckBox x:Name="GreetingCheck" Content="启动时根据本地时间打招呼"/>
                <CheckBox x:Name="AutoStartCheck" Content="开机自启动（登录 Windows 后自动运行）"/>
                <CheckBox x:Name="ShowSettingsButtonCheck" Content="显示角色右上角的设置按钮（默认不显示）"/>
                <CheckBox x:Name="ShowCharacterPanelCheck" Content="在右键菜单中显示角色面板（默认显示）"/>
                <CheckBox x:Name="WeatherCheck" Content="在角色上方显示本地天气（需要联网）" Checked="OnWeatherChanged" Unchecked="OnWeatherChanged"/>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="空闲判定（分钟）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="IdleMinutesBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="互动形象持续（秒）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PlaySecondsBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="切换动画（毫秒）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TransitionBox"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="界面大小（0.1–1.5）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ScaleBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="角色大小（0.1–1.5）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="CharacterScaleBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="主动聊天间隔（分钟，0=关闭）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ChatIdleMinutesBox"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="状态栏大小（0.5–2）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="StatusBarScaleBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="备忘录界面大小（0.5–2）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="MemoUiScaleBox"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="ShowDeviceInfoCheck" Content="在展开状态栏中显示设备信息"/>
                <CheckBox x:Name="ShowRemovableDevicesCheck" Content="在状态栏显示已连接的移动设备"/>
                <CheckBox x:Name="AutoHideCheck" Content="拖到屏幕边缘时自动收起"/>
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="自动收起边缘距离（0–50px）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="EdgeDistanceBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="悬停展开保持（秒）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="EdgeHoverSecondsBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="PanelSettingsSectionTitle" Text="角色面板设置" Style="{StaticResource Section}"/>
                <TextBlock Text="显示 / 隐藏角色面板的快捷键" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,1,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="PanelHotkeyCtrlCheck" Content="Ctrl" Margin="0,0,10,0"/>
                    <CheckBox x:Name="PanelHotkeyAltCheck" Grid.Column="1" Content="Alt" Margin="0,0,10,0"/>
                    <CheckBox x:Name="PanelHotkeyShiftCheck" Grid.Column="2" Content="Shift" Margin="0,0,10,0"/>
                    <CheckBox x:Name="PanelHotkeyWinCheck" Grid.Column="3" Content="Win" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="4" Text="+ 按键" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="PanelHotkeyKeyBox" Grid.Column="5" Width="62" MaxLength="3"
                             HorizontalAlignment="Left" ToolTip="例如 P、5、F1"/>
                </Grid>
                <TextBlock Text="默认 Ctrl+Alt+P。快捷键在主形象右键菜单之外也能使用。"
                           Foreground="#6F8CA6" FontSize="9" Margin="0,1,0,2" TextWrapping="Wrap"/>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="52"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="角色面板透明度（0–100，连续）" Style="{StaticResource FieldLabel}"/>
                        <Slider x:Name="PanelOpacitySlider" Minimum="0" Maximum="100" Value="100"
                                TickFrequency="1" IsSnapToTickEnabled="False"
                                ValueChanged="OnPanelOpacityChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="PanelOpacityValueText" Grid.Column="1" Text="100%"
                               Foreground="#8FD3FF" FontSize="11" VerticalAlignment="Bottom"
                               HorizontalAlignment="Right" Margin="0,0,0,3"/>
                </Grid>
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="52"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="角色面板界面大小（0.5–2）" Style="{StaticResource FieldLabel}"/>
                        <Slider x:Name="PanelScaleSlider" Minimum="0.5" Maximum="2" Value="1"
                                TickFrequency="0.05" IsSnapToTickEnabled="False"
                                ValueChanged="OnPanelScaleChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="PanelScaleValueText" Grid.Column="1" Text="1.00×"
                               Foreground="#8FD3FF" FontSize="11" VerticalAlignment="Bottom"
                               HorizontalAlignment="Right" Margin="0,0,0,3"/>
                </Grid>
                <TextBlock Text="透明度为 0 时面板不可见且不可点击；仍可从主形象右键菜单打开设置并调高。面板缩小时文字不缩小，超出部分可滚动查看。"
                           Foreground="#6F8CA6" FontSize="9" Margin="0,3,0,2" TextWrapping="Wrap"/>

                <TextBlock x:Name="MiniGameSectionTitle" Text="摸鱼游戏设置" Style="{StaticResource Section}"/>
                <Grid Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="52"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="钓鱼进度界面大小（0.5–2）" Style="{StaticResource FieldLabel}"/>
                        <Slider x:Name="FishingOverlayScaleSlider" Minimum="0.5" Maximum="2" Value="1"
                                TickFrequency="0.05" IsSnapToTickEnabled="False"
                                ValueChanged="OnFishingOverlayScaleChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="FishingOverlayScaleValueText" Grid.Column="1" Text="1.00×"
                               Foreground="#8FD3FF" FontSize="11" VerticalAlignment="Bottom"
                               HorizontalAlignment="Right" Margin="0,0,8,3"/>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="烹饪进度界面大小（0.5–2）" Style="{StaticResource FieldLabel}"/>
                        <Slider x:Name="CookingOverlayScaleSlider" Minimum="0.5" Maximum="2" Value="1"
                                TickFrequency="0.05" IsSnapToTickEnabled="False"
                                ValueChanged="OnCookingOverlayScaleChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="CookingOverlayScaleValueText" Grid.Column="4" Text="1.00×"
                               Foreground="#8FD3FF" FontSize="11" VerticalAlignment="Bottom"
                               HorizontalAlignment="Right" Margin="0,0,0,3"/>
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="52"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="进度界面透明度（0–100，钓鱼/烹饪共用）" Style="{StaticResource FieldLabel}"/>
                        <Slider x:Name="MiniGameOpacitySlider" Minimum="0" Maximum="100" Value="100"
                                TickFrequency="1" IsSnapToTickEnabled="False"
                                ValueChanged="OnMiniGameOpacityChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="MiniGameOpacityValueText" Grid.Column="1" Text="100%"
                               Foreground="#8FD3FF" FontSize="11" VerticalAlignment="Bottom"
                               HorizontalAlignment="Right" Margin="0,0,0,3"/>
                </Grid>
                <TextBlock Text="调整后立即应用到已打开的钓鱼/烹饪进度界面，保存后写入本机配置。"
                           Foreground="#6F8CA6" FontSize="9" Margin="0,3,0,2" TextWrapping="Wrap"/>

                <TextBlock x:Name="ReadingSectionTitle" Text="阅读设置" Style="{StaticResource Section}"/>
                <CheckBox x:Name="ReadingEnabledCheck" Content="启用阅读区域"
                          Checked="OnReadingChanged" Unchecked="OnReadingChanged"/>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ReadingTextPathBox" ToolTip="txt 文件路径"
                             TextChanged="OnReadingChanged"/>
                    <Button Grid.Column="1" Content="浏览…" Style="{StaticResource Action}"
                            Margin="6,0,0,0" Click="OnBrowseReadingText"/>
                </Grid>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="阅读区域宽度（30–1200）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ReadingWidthBox" TextChanged="OnReadingChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="阅读区域高度（30–800）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ReadingHeightBox" TextChanged="OnReadingChanged"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="背景颜色（#RRGGBB）" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ReadingBackgroundBox" TextChanged="OnReadingChanged"/>
                            <Button Grid.Column="1" Content="选" Style="{StaticResource Action}"
                                    Width="34" Margin="4,0,0,0" Tag="{Binding ElementName=ReadingBackgroundBox}"
                                    Click="OnPickColor"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="背景透明度（0–100）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ReadingBackgroundOpacityBox" TextChanged="OnReadingChanged"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="文字大小（px）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ReadingFontSizeBox" TextChanged="OnReadingChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="文字颜色" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ReadingTextColorBox" TextChanged="OnReadingChanged"/>
                            <Button Grid.Column="1" Content="选" Style="{StaticResource Action}"
                                    Width="34" Margin="4,0,0,0" Tag="{Binding ElementName=ReadingTextColorBox}"
                                    Click="OnPickColor"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="文字透明度（0–100）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ReadingTextOpacityBox" TextChanged="OnReadingChanged"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="字体系列" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ReadingFontFamilyBox" TextChanged="OnReadingChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="行间距（1.0–2.0）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ReadingLineHeightBox" TextChanged="OnReadingChanged"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="文本编码" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ReadingEncodingCombo" Height="28"
                                  SelectionChanged="OnReadingChanged"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="重新加载文本" Style="{StaticResource Action}"
                            VerticalAlignment="Bottom" Margin="0,0,0,2" Click="OnReloadReadingText"/>
                </Grid>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="每页文字数量（1–1500）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ReadingCharsBox" LostFocus="OnReadingCharsCommit"
                                 KeyDown="OnReadingFieldKeyDown"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock x:Name="ReadingPageLabel" Text="当前页数（1 / 1）"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ReadingPageBox" LostFocus="OnReadingPageCommit"
                                 KeyDown="OnReadingFieldKeyDown"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="重置位置" Style="{StaticResource Action}"
                            VerticalAlignment="Bottom" Margin="0,0,0,2" Click="OnResetReadingPosition"/>
                </Grid>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="显示/隐藏快捷键" Style="{StaticResource FieldLabel}"/>
                        <local:HotkeyRecorderBox x:Name="ReadingShowHotkeyBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="上一页快捷键" Style="{StaticResource FieldLabel}"/>
                        <local:HotkeyRecorderBox x:Name="ReadingPrevHotkeyBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="下一页快捷键" Style="{StaticResource FieldLabel}"/>
                        <local:HotkeyRecorderBox x:Name="ReadingNextHotkeyBox"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="单击控件后按下组合键；Esc 取消，Backspace 清除为“未设置”。上一页/下一页也支持单键，但仅在阅读区域获得焦点时生效；与已有快捷键冲突会提示并阻止保存。"
                           Foreground="#6F8CA6" FontSize="9" Margin="0,2,0,2" TextWrapping="Wrap"/>

                <TextBlock x:Name="MigrationSectionTitle" Text="迁移数据" Style="{StaticResource Section}"/>
                <TextBlock x:Name="MigrationStepsText" FontSize="9.5" Foreground="#9AB6CE"
                           TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="第一步：在旧电脑打开「设置 → 迁移数据 → 导出迁移包」，设置密码并保存 .whalepet 文件。&#10;第二步：在新电脑安装并启动鲸鱼娘。&#10;第三步：打开「设置 → 迁移数据 → 导入迁移包」，选择文件并输入密码。&#10;第四步：如果提示未激活，点击「迁移激活」，按窗口提示完成一次性激活。&#10;第五步：导入成功会覆盖当前用户数据，签到、任务与每日次数按新电脑时间重置。"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <Button Content="导出迁移包…" Style="{StaticResource Action}" Click="OnExportMigration"/>
                    <Button Content="导入迁移包…" Style="{StaticResource Action}" Click="OnImportMigration"/>
                    <Button Content="迁移激活…" Style="{StaticResource Action}" Click="OnActivationMigration"/>
                </StackPanel>

                <TextBlock x:Name="UninstallSectionTitle" Text="卸载桌宠" Style="{StaticResource Section}"/>
                <TextBlock Text="打开卸载向导。默认保留用户数据；只有主动勾选“清空所有桌宠相关数据”并二次确认后，才会删除设置、游戏数据、备忘录、剪贴板、待办、角色形象、闹钟和备份。"
                           Foreground="#9AB6CE" FontSize="9.5" TextWrapping="Wrap" Margin="0,2,0,6"/>
                <Button Content="打开卸载向导…" Style="{StaticResource Action}" Click="OnUninstallPet"
                        HorizontalAlignment="Left"/>

                    </StackPanel>
                </Grid>

                <TextBlock x:Name="AppearanceSectionTitle" Text="外观" Style="{StaticResource Section}"/>
                <Grid Margin="0,3,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="状态栏文字大小（px）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="StatusFontSizeBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="设置文字大小（px）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SettingsFontSizeBox"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,5,8,0">
                        <TextBlock Text="备忘录文字大小（px）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="MemoFontSizeBox"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,5,0,0">
                        <TextBlock Text="互动气泡文字大小（px）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SpeechBubbleFontSizeBox"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="界面主题色（#RRGGBB）" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ThemeColorBox"/>
                            <Button Grid.Column="1" Content="选" Style="{StaticResource Action}"
                                    Width="34" Margin="4,0,0,0" Tag="{Binding ElementName=ThemeColorBox}"
                                    Click="OnPickColor"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="状态栏文字颜色" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="StatusTextColorBox"/>
                            <Button Grid.Column="1" Content="选" Style="{StaticResource Action}"
                                    Width="34" Margin="4,0,0,0" Tag="{Binding ElementName=StatusTextColorBox}"
                                    Click="OnPickColor"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,5,8,0">
                        <TextBlock Text="设置文字颜色" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SettingsTextColorBox"/>
                            <Button Grid.Column="1" Content="选" Style="{StaticResource Action}"
                                    Width="34" Margin="4,0,0,0" Tag="{Binding ElementName=SettingsTextColorBox}"
                                    Click="OnPickColor"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,5,0,0">
                        <TextBlock Text="备忘录文字颜色" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MemoTextColorBox"/>
                            <Button Grid.Column="1" Content="选" Style="{StaticResource Action}"
                                    Width="34" Margin="4,0,0,0" Tag="{Binding ElementName=MemoTextColorBox}"
                                    Click="OnPickColor"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <TextBlock Text="控件大小" Style="{StaticResource Section}"/>
                <Grid Margin="0,3,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="设置按钮大小（0.5–2）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SettingsButtonScaleBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="互动气泡大小（0.5–2）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SpeechBubbleScaleBox"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,5,8,0">
                        <TextBlock Text="键鼠状态大小（0.5–2）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="InputBadgeScaleBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="主题背景" Style="{StaticResource Section}"/>
                <CheckBox x:Name="BackgroundImageCheck" Content="启用背景图片（作为桌宠窗口背景）"/>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="BackgroundImageBox" ToolTip="背景图片文件路径"/>
                    <Button Grid.Column="1" Content="浏览…" Style="{StaticResource Action}"
                            Margin="6,0,0,0" Click="OnBrowseBackground"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="背景图片透明度（0–1）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="BackgroundOpacityBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ScreenshotSectionTitle" Text="截图" Style="{StaticResource Section}"/>
                <CheckBox x:Name="ScreenshotCheck" Content="启用截图快捷键（Windows 全局）"/>
                <Grid Margin="0,4,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ScreenshotCtrlCheck" Content="Ctrl" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ScreenshotAltCheck" Grid.Column="1" Content="Alt" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ScreenshotShiftCheck" Grid.Column="2" Content="Shift" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ScreenshotWinCheck" Grid.Column="3" Content="Win" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="4" Text="+ 按键" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="ScreenshotKeyBox" Grid.Column="5" Width="62" MaxLength="3"
                             ToolTip="例如 A、5、F1"/>
                </Grid>
                <TextBlock Text="例如 Ctrl+Alt+A。截图时拖动选择区域，可拖动边缘调整，再编辑文字、线条、箭头、方框并保存为 PNG。"
                           Foreground="#6F8CA6" FontSize="9" Margin="0,2,0,2" TextWrapping="Wrap"/>

                <TextBlock x:Name="WeatherSectionTitle" Text="天气位置" Style="{StaticResource Section}"/>
                <Grid Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="天气位置（只填一个城市，留空则按 IP 自动定位）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WeatherCityBox" MaxLength="30"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="天气文字大小（px）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WeatherFontSizeBox"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="例如：杭州、上海、Tokyo。请勿填写多个城市或使用逗号分隔；天气文字大小独立于状态栏。"
                           Foreground="#6F8CA6" FontSize="9" Margin="0,4,0,2" TextWrapping="Wrap"/>

                <TextBlock x:Name="WorkSectionTitle" Text="工作日程" Style="{StaticResource Section}"/>
                <UniformGrid Columns="7" Margin="0,2,0,4">
                    <CheckBox x:Name="WorkMonCheck" Content="周一" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="WorkTueCheck" Content="周二" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="WorkWedCheck" Content="周三" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="WorkThuCheck" Content="周四" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="WorkFriCheck" Content="周五" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="WorkSatCheck" Content="周六" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="WorkSunCheck" Content="周日" VerticalAlignment="Center"/>
                </UniformGrid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="上班时间（HH:mm）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WorkStartBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="下班时间（HH:mm）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WorkEndBox"/>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="ShowWorkBadgeCheck" Content="搬砖提示框(角色左侧显示)"/>
                <TextBox x:Name="WorkBadgeTextBox" Margin="0,2,0,4"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="搬砖提示框大小（0.5–2）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WorkBadgeScaleBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="搬砖提示框文字大小（px）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WorkBadgeFontSizeBox"/>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="ShowBeforeWorkReminderCheck" Content="显示下班前提示"/>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="提前提醒（分钟）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="BeforeWorkMinutesBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="下班前提示内容" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WorkBeforeReminderBox"/>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="ShowEndWorkReminderCheck" Content="显示下班时间提示"/>
                <TextBlock Text="下班时间提示" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="WorkEndReminderBox"/>

                <TextBlock x:Name="ReminderSectionTitle" Text="提醒与工具" Style="{StaticResource Section}"/>
                <CheckBox x:Name="ShowWaterReminderCheck" Content="启用喝水提醒（通过角色气泡提示）"/>
                <CheckBox x:Name="WaterPopupCheck" Content="喝水提醒同时弹窗提示"/>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="喝水提醒间隔（分钟）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WaterMinutesBox"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="5–240 分钟"
                               Foreground="#6F8CA6" FontSize="9" VerticalAlignment="Bottom"
                               Margin="0,0,0,7"/>
                </Grid>
                <CheckBox x:Name="SedentaryCheck" Content="启用久坐提醒（通过角色气泡提示）"/>
                <CheckBox x:Name="SedentaryPopupCheck" Content="久坐提醒同时弹窗提示"/>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="久坐提醒间隔（分钟）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SedentaryMinutesBox"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="0 = 关闭久坐提醒"
                               Foreground="#6F8CA6" FontSize="9" VerticalAlignment="Bottom"
                               Margin="0,0,0,7"/>
                </Grid>
                <CheckBox x:Name="AlarmsCheck" Content="启用闹钟提醒"/>
                <Grid Margin="0,2,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AlarmSummary" Foreground="#9AB6CE" FontSize="10"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Content="编辑闹钟…" Style="{StaticResource Action}"
                            Margin="8,0,0,0" Click="OnEditAlarms"/>
                </Grid>
                <CheckBox x:Name="ClipboardCheck" Content="启用剪贴板历史（只记录文本，最多 50 条）"/>
                <CheckBox x:Name="LockScreenCheck" Content="显示一键锁屏按钮"/>

                <TextBlock x:Name="OrganizerSectionTitle" Text="图标收纳区设置" Style="{StaticResource Section}"/>
                <CheckBox x:Name="OrganizerEnabledCheck" Content="启用桌面图标收纳区"/>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="收纳区宽度（300–1200）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="OrganizerWidthBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="收纳区高度（300–1000）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="OrganizerHeightBox"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="背景颜色（#RRGGBB）" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OrganizerBackgroundBox"/>
                            <Button Grid.Column="1" Content="选" Style="{StaticResource Action}"
                                    Width="34" Margin="4,0,0,0" Tag="{Binding ElementName=OrganizerBackgroundBox}"
                                    Click="OnPickColor"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="背景透明度（0–100）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="OrganizerOpacityBox"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="收纳区内容大小不随窗口缩放，内容过多时使用垂直滚动条。"
                           Foreground="#6F8CA6" FontSize="9" Margin="0,1,0,2" TextWrapping="Wrap"/>

                <TextBlock x:Name="TodoSectionTitle" Text="桌面待办区设置" Style="{StaticResource Section}"/>
                <CheckBox x:Name="TodoEnabledCheck" Content="启用桌面待办区"/>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="待办区宽度（300–1200）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TodoWidthBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="待办区高度（300–1000）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TodoHeightBox"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="背景颜色（#RRGGBB）" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TodoBackgroundBox"/>
                            <Button Grid.Column="1" Content="选" Style="{StaticResource Action}"
                                    Width="34" Margin="4,0,0,0" Tag="{Binding ElementName=TodoBackgroundBox}"
                                    Click="OnPickColor"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="背景透明度（0–100）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TodoOpacityBox"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="待办区内容大小不随窗口缩放，内容过多时使用垂直滚动条。"
                           Foreground="#6F8CA6" FontSize="9" Margin="0,1,0,4" TextWrapping="Wrap"/>

                <TextBlock x:Name="CharacterImageSectionTitle" Text="角色形象（勾选启用；支持绝对路径或相对本程序的 Assets 路径）" Style="{StaticResource Section}"/>
                <TextBlock Text="主形象（内置默认形象不可删除；自定义最多 5 张，默认启用，可禁用）"
                           Style="{StaticResource FieldLabel}"/>
                <StackPanel x:Name="DefaultAvatarRows" Margin="0,2,0,2"/>
                <Button x:Name="AddDefaultAvatarButton" Content="添加自定义主形象…" Style="{StaticResource Action}"
                        HorizontalAlignment="Left" Margin="0,2,0,8" Click="OnAddDefaultAvatar"/>
                <TextBlock Text="禁用的自定义主形象不在切换形象窗口“默认主形象”Tab 中显示；内置图固定保留。"
                           Foreground="#6F8CA6" FontSize="9" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBlock Text="空闲 / 休眠形象" Style="{StaticResource FieldLabel}"/>
                <StackPanel x:Name="IdleImageRows" Margin="0,2,0,2"/>
                <Button Content="添加空闲形象图片…" Style="{StaticResource Action}" HorizontalAlignment="Left"
                        Margin="0,2,0,8" Click="OnAddIdleImage"/>
                <TextBlock Text="互动形象" Style="{StaticResource FieldLabel}"/>
                <StackPanel x:Name="PlayImageRows" Margin="0,2,0,2"/>
                <Button Content="添加互动形象图片…" Style="{StaticResource Action}" HorizontalAlignment="Left"
                        Margin="0,2,0,8" Click="OnAddPlayImage"/>
                <TextBlock Text="每张图片前的勾选框控制是否启用；新增图片默认启用；每种状态至少保留 1 张启用图片。"
                           Foreground="#6F8CA6" FontSize="9" Margin="0,2,0,0"/>
                <TextBlock x:Name="InteractionSectionTitle" Text="点击互动的短句（每行一条，至少 1 条）" Style="{StaticResource Section}"/>
                <TextBox x:Name="PhrasesBox" AcceptsReturn="True" Height="92" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                <TextBlock Text="主动聊天内容（每行一条；间隔大于 0 时至少 1 条）" Style="{StaticResource Section}"/>
                <TextBox x:Name="ChatPhrasesBox" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ConfigHint" Foreground="#6F8CA6" FontSize="9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="关闭" Style="{StaticResource Action}" Click="OnClose"/>
                <Button Content="取消" Style="{StaticResource Action}" Click="OnCancel"/>
                <Button x:Name="SaveButton" Content="保存" Style="{StaticResource Primary}" Click="OnSave"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
