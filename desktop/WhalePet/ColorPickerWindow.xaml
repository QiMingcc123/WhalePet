<Window x:Class="WhalePet.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择颜色"
        Width="470"
        Height="440"
        MinWidth="430"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#081A32"
        Foreground="#EAF6FF"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CFEAFF"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F8FD3FF"/>
            <Setter Property="Foreground" Value="#EAF6FF"/>
            <Setter Property="BorderBrush" Value="#3D8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#EAF6FF"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#0F8FD3FF"/>
            <Setter Property="Foreground" Value="#CFEAFF"/>
            <Setter Property="BorderBrush" Value="#4D8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#358FD3FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="选择颜色" FontSize="18" FontWeight="Bold" Foreground="#F3FAFF"/>
            <TextBlock Text="点击色块，或直接输入 #RRGGBB。" Foreground="#7FA5C5" FontSize="10" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,12,0,10" Padding="6" CornerRadius="8"
                Background="#0A1628" BorderBrush="#2A5A80" BorderThickness="1">
            <UniformGrid x:Name="PaletteGrid" Columns="8"/>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="颜色值" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Border x:Name="Preview" Grid.Column="1" Width="34" Height="30" CornerRadius="5"
                    Background="#4D6BFE" BorderBrush="#66FFFFFF" BorderThickness="1" Margin="0,0,8,0"/>
            <TextBox x:Name="HexBox" Grid.Column="2" MaxLength="7" TextChanged="OnHexChanged"/>
            <TextBlock Grid.Column="3" Text="#RRGGBB" Foreground="#6F8CA6" FontSize="9"
                       VerticalAlignment="Center" Margin="6,0,0,0"/>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorText" Foreground="#FFB4A8" FontSize="10" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="取消" Style="{StaticResource Action}" Click="OnCancel"/>
                <Button x:Name="OkButton" Content="确定" Style="{StaticResource Action}" Click="OnOk"
                        Background="#4D6BFE" BorderBrush="#4D6BFE" Foreground="#FFFFFF"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
