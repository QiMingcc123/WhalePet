<Window x:Class="WhalePet.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="桌面待办"
        Width="620"
        Height="680"
        MinWidth="300"
        MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized"
        Closed="OnClosed"
        LocationChanged="OnBoundsChanged"
        SizeChanged="OnBoundsChanged"
        Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="TodoFilterChip" TargetType="ToggleButton" BasedOn="{StaticResource PetFilterChip}"/>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" CornerRadius="12" BorderBrush="#558FD3FF" BorderThickness="1">
        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2E8FD3FF" CornerRadius="8" Padding="7,1">
                        <TextBlock Text="待" FontSize="13" FontWeight="Bold" Foreground="#8FD3FF"/>
                    </Border>
                    <TextBlock Text="桌面待办" FontSize="15" FontWeight="Bold" Foreground="#F3FAFF"
                               Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="+ 新增" Width="64" Height="26" Margin="0,0,6,0"
                            Background="#4D6BFE" Foreground="#FFFFFF" BorderBrush="#7E93FF"
                            BorderThickness="1" Click="OnAddClick"/>
                    <Button Content="×" Width="26" Height="26" Padding="0" FontSize="13"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="#33FF6B6B"
                            Foreground="#FFE1E1" BorderBrush="#88FF8A8A" BorderThickness="1"
                            Click="OnCloseClick"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,9,0,2">
                <TextBox x:Name="SearchBox" Style="{StaticResource PetSearchBox}"
                         Padding="9,5,34,5" TextChanged="OnSearchChanged"
                         KeyDown="OnSearchKeyDown"/>
                <TextBlock x:Name="SearchPlaceholder" Text="搜索标题或备注..."
                           Foreground="#6F8CA6" FontSize="10.5" Margin="10,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button x:Name="ClearSearchButton" Content="×" Width="24" Height="22" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                        Background="#338FD3FF" Foreground="#DFF2FF" BorderBrush="#4D8FD3FF"
                        BorderThickness="1" Visibility="Collapsed" Click="OnClearSearchClick"
                        ToolTip="清空搜索"/>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,2,0,0">
                <Grid>
                    <TextBlock Text="时间" Foreground="#9AB6CE" FontSize="10" VerticalAlignment="Center"/>
                    <Button Content="清除筛选" Height="22" Padding="7,0" HorizontalAlignment="Right"
                            Background="#1F8FD3FF" Foreground="#DFF2FF" BorderBrush="#5A8FD3FF"
                            BorderThickness="1" Click="OnClearFilterClick"/>
                </Grid>
                <WrapPanel x:Name="TimeFilterPanel" Margin="0,3,0,2"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,2,0,0">
                <TextBlock Text="紧急程度" Foreground="#9AB6CE" FontSize="10"/>
                <WrapPanel x:Name="UrgencyFilterPanel" Margin="0,3,0,2"/>
            </StackPanel>

            <Grid Grid.Row="4" Margin="0,4,0,0">
                <ScrollViewer x:Name="ItemsScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ItemsPanel"/>
                </ScrollViewer>
                <Border x:Name="EmptyState" Visibility="Collapsed"
                        Background="#120E2C4C" BorderBrush="#2C5B84" BorderThickness="1"
                        CornerRadius="10" Padding="20,24" HorizontalAlignment="Center"
                        VerticalAlignment="Center" MinWidth="240">
                    <StackPanel>
                        <TextBlock Text="没有找到匹配的待办" Foreground="#CFEAFF" FontSize="13"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="试试调整搜索词或筛选条件" Foreground="#7FA5C5" FontSize="10"
                                   Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="5" Margin="0,6,0,0">
                <TextBlock x:Name="CountText" Foreground="#7FA5C5" FontSize="9" VerticalAlignment="Center"/>
                <TextBlock x:Name="FilterHintText" Foreground="#6F8CA6" FontSize="9"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Text="双击编辑 · 右键更多" Foreground="#5E7F9C" FontSize="9"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Window>
