<Window x:Class="WhalePet.Game.CookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="烹饪"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        Focusable="True"
        FontFamily="Microsoft YaHei UI"
        Loaded="OnLoaded"
        KeyDown="OnKeyDown"
        Closing="OnClosing"
        Closed="OnClosed">
    <Window.Resources>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#1F8FD3FF"/>
            <Setter Property="Foreground" Value="#DFF2FF"/>
            <Setter Property="BorderBrush" Value="#5A8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#5A8FD3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Choice" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#132C48"/>
            <Setter Property="BorderBrush" Value="#4D8FD3FF"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Exit" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#33FF6B6B"/>
            <Setter Property="BorderBrush" Value="#88FF8A8A"/>
            <Setter Property="Foreground" Value="#FFE1E1"/>
        </Style>
    </Window.Resources>

    <Border x:Name="ScaleRoot" Background="Transparent" CornerRadius="0"
            BorderBrush="Transparent" BorderThickness="0">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="OverlayScale" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <Grid>
            <Border x:Name="SetupCard" Background="#F507182E" BorderBrush="#6B8FD3FF"
                    BorderThickness="1" CornerRadius="12" Padding="16,13" Width="492">
                <StackPanel x:Name="SetupPanel">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#2E8FD3FF" CornerRadius="8" Padding="7,1">
                            <TextBlock Text="烹" FontSize="13" FontWeight="Bold" Foreground="#8FD3FF"/>
                        </Border>
                        <TextBlock Text="烹饪" FontSize="15" FontWeight="Bold" Foreground="#F3FAFF"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RemainingText" FontSize="10" Foreground="#8FD3FF"
                                   Margin="10,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="选择难度后立即扣除 1 次每日次数和 1 条小鱼，开始后不能中途退出。"
                               FontSize="9.5" Foreground="#9AB6CE" TextWrapping="Wrap" Margin="0,8,0,9"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Choice}" Content="简单（1 次）" Tag="easy" Click="OnDifficultyClick"/>
                        <Button Style="{StaticResource Choice}" Content="普通（2 次）" Tag="normal" Click="OnDifficultyClick"/>
                        <Button Style="{StaticResource Choice}" Content="困难（3 次）" Tag="hard" Click="OnDifficultyClick"/>
                        <Button Style="{StaticResource Exit}" Content="退出" Click="OnExitSetupClick"/>
                    </StackPanel>
                    <TextBlock x:Name="SetupHint" FontSize="9" Foreground="#6F8CA6" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Text="进度条 10 秒走完，条上有 3 个随机烹饪点；在烹饪点上按空格成功，按在区域外直接失败。"/>
                </StackPanel>
            </Border>

            <Grid x:Name="GamePanel" Width="492" Margin="0,4,0,4" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="StatusText" Text="食材下锅，注意烹饪点" FontSize="11"
                               Foreground="#FFD77A">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="HitText" FontSize="10" Foreground="#8FD3FF"
                               HorizontalAlignment="Right">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,6">
                    <Border Height="40" CornerRadius="8" Background="Transparent"
                            BorderBrush="#8A8FD3FF" BorderThickness="1"/>
                    <Canvas x:Name="TrackCanvas" Width="460" Height="40" ClipToBounds="True"
                            HorizontalAlignment="Center" Background="Transparent">
                        <Canvas x:Name="ZoneCanvas"/>
                        <Rectangle x:Name="PointerBar" Width="3" Height="40" Fill="#FFD77A"/>
                    </Canvas>
                </Grid>

                <TextBlock x:Name="HintText" Grid.Row="2" FontSize="9.5" Foreground="#CFEAFF"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="空格命中烹饪点；同一个点只计一次，按在区域外会直接失败。">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="#000000"/>
                    </TextBlock.Effect>
                </TextBlock>

                <StackPanel Grid.Row="3" Margin="0,5,0,0">
                    <TextBlock x:Name="ResultText" FontSize="11" Foreground="#CFEAFF"
                               TextAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
