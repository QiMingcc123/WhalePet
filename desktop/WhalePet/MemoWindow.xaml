<Window x:Class="WhalePet.MemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="鲸鱼娘备忘录"
        Width="560"
        Height="640"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F6EED8"
        Foreground="#3A2A18"
        FontFamily="KaiTi, Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="MemoTextBrush" Color="#3A2A18"/>
        <sys:Double x:Key="MemoFontSize">12</sys:Double>
        <sys:Double x:Key="MemoLineHeight">24</sys:Double>
        <DrawingBrush x:Key="PaperLines" TileMode="Tile" Viewport="0,0,1000,24" ViewportUnits="Absolute" Stretch="Fill">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FBF5E5" Geometry="M0,0 H1000 V24 H0 Z"/>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#D8C49A" Thickness="0.8"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <LineGeometry StartPoint="0,23.5" EndPoint="1000,23.5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3A2A18"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#66FFFFFF"/>
            <Setter Property="Foreground" Value="#3A2A18"/>
            <Setter Property="BorderBrush" Value="#CBB990"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontFamily" Value="KaiTi, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#7A2F2F"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#3A2A18"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#66FFFFFF"/>
            <Setter Property="Foreground" Value="#4B3821"/>
            <Setter Property="BorderBrush" Value="#B8A47D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#4D6BFE"/>
            <Setter Property="BorderBrush" Value="#4D6BFE"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="PaperComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#3A2A18"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="Transparent"
                                Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#E9DDC0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#DCCBA4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PaperCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#66FFFFFF"/>
            <Setter Property="Foreground" Value="#3A2A18"/>
            <Setter Property="BorderBrush" Value="#CBB990"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource PaperComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Surface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="9,0,2,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                    <TextBlock Grid.Column="1" Text="▾" Foreground="#8A7656"
                                               FontSize="10" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#FFF9EC" BorderBrush="#CBB990" BorderThickness="1"
                                        CornerRadius="5" Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="230">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#B49C6E"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#A88D5C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="鲸鱼娘备忘录" FontSize="19" FontWeight="Bold" Foreground="#2B2012"/>
            <TextBlock x:Name="MemoHint" Text="保存在本机，最多保留 100 条。"
                       Foreground="#7A674A" FontSize="10" Margin="0,4,0,0"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       ToolTipService.Placement="Top"/>
            <TextBlock Text="点击备忘录内容可在互动中显示，再次点击取消（文字下方出现红色细线）。"
                       Foreground="#6F5A3B" FontSize="10.5" FontWeight="SemiBold" Margin="0,3,0,0"/>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="MemoSearchBox" Background="#66FFFFFF" BorderBrush="#CBB990"
                             BorderThickness="1" Padding="9,6" FontSize="12"
                             ToolTip="只按备忘录内容搜索"
                             TextChanged="OnSearchChanged"/>
                    <TextBlock x:Name="MemoSearchPlaceholder" Text="按内容关键字搜索…"
                               Foreground="#9A8766" FontSize="11" Margin="11,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <ComboBox x:Name="MemoTimeFilter" Grid.Column="1" Width="120" Margin="8,0,0,0"
                          Style="{StaticResource PaperCombo}"
                          ToolTip="按添加时间筛选备忘录"
                          SelectionChanged="OnTimeFilterChanged">
                    <ComboBoxItem Content="全部时间" Tag="all" IsSelected="True"/>
                    <ComboBoxItem Content="今天" Tag="today"/>
                    <ComboBoxItem Content="近 3 天" Tag="3d"/>
                    <ComboBoxItem Content="近 7 天" Tag="7d"/>
                    <ComboBoxItem Content="近 30 天" Tag="30d"/>
                    <ComboBoxItem Content="本月" Tag="month"/>
                </ComboBox>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BulkTip" Text="" Foreground="#8A7656" FontSize="10"
                           VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BulkToggleButton" Content="批量删除" Style="{StaticResource Action}"
                            Click="OnToggleBulk" ToolTip="进入批量删除模式"/>
                    <Button x:Name="BulkSelectAllButton" Content="全选" Style="{StaticResource Action}"
                            Click="OnSelectAll" Visibility="Collapsed"/>
                    <Button x:Name="BulkDeleteButton" Content="删除选中" Style="{StaticResource Action}"
                            Click="OnBulkDelete" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,12,0,10" Padding="10" CornerRadius="7"
                Background="{DynamicResource PaperLines}" BorderBrush="#C9B78E" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MemoList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="8,0,8,4" CornerRadius="5"
                                    Background="{DynamicResource PaperLines}" BorderBrush="#D8C49A" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,3,6,0" VerticalAlignment="Top"
                                              Visibility="{Binding BulkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                              ToolTip="选中后使用“删除选中”批量删除"/>
                                    <Border Grid.Column="1" Background="Transparent" Cursor="Hand"
                                            Tag="{Binding}" MouseLeftButtonUp="OnMemoContentClick"
                                            ToolTip="点击在互动中显示或取消（文字下方红线）">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                       FontSize="{DynamicResource MemoFontSize}"
                                                       LineHeight="{DynamicResource MemoLineHeight}"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       Foreground="{DynamicResource MemoTextBrush}"/>
                                            <Border Height="1" Background="#C94B4B" Margin="0,1,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Done}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding CreatedAtDisplay}" FontSize="8" Foreground="#8A7656" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="2" Content="✎" Tag="{Binding}" Click="OnEditMemo"
                                            Style="{StaticResource Action}" Width="30" Height="30"
                                            FontSize="14" Padding="0" Margin="6,0,0,0" VerticalAlignment="Top"
                                            ToolTip="编辑备忘录"/>
                                    <Button Grid.Column="3" Content="×" Tag="{Binding}" Click="OnDeleteMemo"
                                            Style="{StaticResource Action}" Width="34" Height="30"
                                            FontSize="16" Padding="0" Margin="6,0,0,0" VerticalAlignment="Top"
                                            ToolTip="删除备忘录"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2">
            <Border Background="{DynamicResource PaperLines}" BorderBrush="#CBB990" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <TextBox x:Name="MemoInput" AcceptsReturn="True" Height="82"
                             Background="Transparent" BorderThickness="0"
                             Padding="9,0,9,0"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             TextWrapping="Wrap" FontFamily="KaiTi, Microsoft YaHei UI"
                             Foreground="{DynamicResource MemoTextBrush}"
                             FontSize="{DynamicResource MemoFontSize}"
                             TextChanged="OnMemoInputChanged"/>
                    <TextBlock x:Name="MemoInputPlaceholder" Text="写点要跟进的事…"
                               Foreground="#9A8766" FontSize="11" Margin="12,2,0,0"
                               VerticalAlignment="Top" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Foreground="#A94B4B" FontSize="9" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="关闭" Style="{StaticResource Action}" Click="OnClose"/>
                    <Button x:Name="AddButton" Content="添加备忘录" Style="{StaticResource Primary}" Click="OnAddMemo"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
