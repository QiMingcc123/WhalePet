<Window x:Class="WhalePet.Game.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="迁移激活"
        Width="600"
        Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#1F8FD3FF"/>
            <Setter Property="Foreground" Value="#DFF2FF"/>
            <Setter Property="BorderBrush" Value="#5A8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#4D6BFE"/>
            <Setter Property="BorderBrush" Value="#7E93FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#132C48"/>
            <Setter Property="Foreground" Value="#EAF6FF"/>
            <Setter Property="BorderBrush" Value="#3D8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="CaretBrush" Value="#EAF6FF"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#FF07182E" BorderBrush="#558FD3FF" BorderThickness="1">
        <Grid Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="迁移激活" FontSize="17" FontWeight="Bold" Foreground="#F3FAFF"/>
                    <TextBlock Text="迁移包不包含激活状态。换机后可用一次性迁移码重新绑定；旧设备迁移码 24 小时内有效且只能使用一次。"
                               FontSize="10" Foreground="#9AB6CE" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource Action}" Content="✕" Width="30" Height="28" Padding="0"
                        FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCloseClick"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,10">
                <StackPanel>
                    <Border Background="#140E2C4C" BorderBrush="#338FD3FF" BorderThickness="1"
                            CornerRadius="12" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="旧设备：生成一次性迁移码" FontSize="11" FontWeight="Bold" Foreground="#8FD3FF"/>
                            <TextBlock Text="迁移码只含 MAC 哈希、时间戳、随机数与 InstallId 签名，不含明文 MAC。"
                                       FontSize="9.5" Foreground="#6F8CA6" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <Button x:Name="GenerateButton" Style="{StaticResource Primary}" Content="生成迁移码"
                                    HorizontalAlignment="Left" Click="OnGenerateClick"/>
                            <TextBox x:Name="CodeBox" IsReadOnly="True" TextWrapping="Wrap" Height="82"
                                     Margin="0,9,0,0" VerticalScrollBarVisibility="Auto"/>
                            <Button x:Name="CopyButton" Style="{StaticResource Action}" Content="复制迁移码"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnCopyClick"
                                    IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#140E2C4C" BorderBrush="#338FD3FF" BorderThickness="1"
                            CornerRadius="12" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="新设备：使用迁移码" FontSize="11" FontWeight="Bold" Foreground="#8FD3FF"/>
                            <TextBlock Text="粘贴旧设备生成的迁移码。校验签名、24 小时有效期与一次性使用记录。"
                                       FontSize="9.5" Foreground="#6F8CA6" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <TextBox x:Name="RedeemBox" Height="82" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                            <Button Style="{StaticResource Primary}" Content="迁移激活" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" Click="OnRedeemClick"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="StatusText" FontSize="10.5" Foreground="#8FD3FF" TextWrapping="Wrap"
                               Margin="2,10,2,0"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Action}" Content="关闭" Click="OnCloseClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
