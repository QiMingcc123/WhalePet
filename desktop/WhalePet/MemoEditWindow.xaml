<Window x:Class="WhalePet.MemoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑备忘录"
        Width="500"
        Height="340"
        MinWidth="420"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        Background="#F6EED8"
        Foreground="#3A2A18"
        FontFamily="KaiTi, Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3A2A18"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#66FFFFFF"/>
            <Setter Property="Foreground" Value="#3A2A18"/>
            <Setter Property="BorderBrush" Value="#CBB990"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontFamily" Value="KaiTi, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#7A2F2F"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#66FFFFFF"/>
            <Setter Property="Foreground" Value="#4B3821"/>
            <Setter Property="BorderBrush" Value="#B8A47D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#4D6BFE"/>
            <Setter Property="BorderBrush" Value="#4D6BFE"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="编辑备忘录" FontSize="18" FontWeight="Bold" Foreground="#2B2012"/>
            <TextBlock Text="修改后会保存，原始添加时间不变。"
                       Foreground="#7A674A" FontSize="10" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,12,0,10" Padding="4" CornerRadius="6"
                Background="#66FFFFFF" BorderBrush="#CBB990" BorderThickness="1">
            <TextBox x:Name="Editor" AcceptsReturn="True" TextWrapping="Wrap"
                     Background="Transparent" BorderThickness="0"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     FontSize="13" Padding="8,6"/>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorText" Foreground="#A94B4B" FontSize="10" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="取消" Style="{StaticResource Action}" Click="OnCancel"/>
                <Button Content="保存" Style="{StaticResource Primary}" Click="OnSave"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
