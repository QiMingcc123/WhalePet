<Window x:Class="WhalePet.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鲸鱼娘"
        Width="620"
        Height="270"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Opacity="0"
        TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Border x:Name="Card"
                Width="520"
                Height="190"
                CornerRadius="28"
                BorderThickness="1"
                BorderBrush="#668FD3FF"
                Background="#EE07182E"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="0.9" ScaleY="0.9"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="46" ShadowDepth="0" Color="#000000" Opacity="0.55"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="AuthorPanel"
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="AuthorTranslate" Y="14"/>
                    </StackPanel.RenderTransform>
                    <TextBlock Text="🐋"
                               FontSize="34"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="AuthorText"
                               Text="Create by QiMingcc"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="#EAF6FF"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <Border x:Name="Underline"
                        Grid.Row="1"
                        Height="3"
                        Width="0"
                        Margin="0,0,0,30"
                        CornerRadius="1.5"
                        Background="#8FD3FF"
                        HorizontalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
