<Window x:Class="WhalePet.AlarmTimePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择提醒时间"
        Width="520"
        Height="330"
        MinWidth="480"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#081A32"
        Foreground="#EAF6FF"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CFEAFF"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CFEAFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EAF6FF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="Transparent"
                                Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#1F4C72"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#2A6390"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EAF6FF"/>
            <Setter Property="Background" Value="#0F8FD3FF"/>
            <Setter Property="BorderBrush" Value="#3D8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="8,0,2,0" VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                    <TextBlock Grid.Column="1" Text="▾" Foreground="#8FD3FF"
                                               FontSize="9" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#0B2038" BorderBrush="#3D8FD3FF" BorderThickness="1"
                                        CornerRadius="5" Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="210">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#0F8FD3FF"/>
            <Setter Property="Foreground" Value="#CFEAFF"/>
            <Setter Property="BorderBrush" Value="#4D8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#358FD3FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#4D6BFE"/>
            <Setter Property="BorderBrush" Value="#4D6BFE"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="选择提醒时间" FontSize="18" FontWeight="Bold" Foreground="#F3FAFF"/>
            <TextBlock Text="选择年、月、日、时、分。勾选“每天”表示每天重复，否则只在所选日期提醒。"
                       Foreground="#7FA5C5" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="日期" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="YearBox" Grid.Column="1" Width="84" Style="{StaticResource DarkCombo}"
                      SelectionChanged="OnDatePartChanged" ToolTip="年"/>
            <TextBlock Grid.Column="2" Text="年" VerticalAlignment="Center" Margin="5,0,10,0"/>
            <ComboBox x:Name="MonthBox" Grid.Column="3" Width="62" Style="{StaticResource DarkCombo}"
                      SelectionChanged="OnDatePartChanged" ToolTip="月"/>
            <TextBlock Grid.Column="4" Text="月" VerticalAlignment="Center" Margin="5,0,10,0"/>
            <ComboBox x:Name="DayBox" Grid.Column="5" Width="62" Style="{StaticResource DarkCombo}" ToolTip="日"/>
            <TextBlock Grid.Column="6" Text="日" VerticalAlignment="Center" Margin="5,0,0,0"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="DailyCheck" Content="每天" Margin="0,0,16,0" Checked="OnDailyChanged" Unchecked="OnDailyChanged"/>
            <TextBlock Grid.Column="1" Text="开始" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="HourBox" Grid.Column="2" Width="62" Style="{StaticResource DarkCombo}" ToolTip="时"/>
            <TextBlock Grid.Column="3" Text=":" VerticalAlignment="Center" Margin="6,0,6,0"/>
            <ComboBox x:Name="MinuteBox" Grid.Column="4" Width="62" Style="{StaticResource DarkCombo}" ToolTip="分"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="EndCheck" Content="设置结束时间" Margin="0,0,16,0"
                      Checked="OnEndChanged" Unchecked="OnEndChanged"/>
            <ComboBox x:Name="EndHourBox" Grid.Column="1" Width="62" Style="{StaticResource DarkCombo}" ToolTip="结束时"/>
            <TextBlock Grid.Column="2" Text=":" VerticalAlignment="Center" Margin="6,0,6,0"/>
            <ComboBox x:Name="EndMinuteBox" Grid.Column="3" Width="62" Style="{StaticResource DarkCombo}" ToolTip="结束分"/>
            <TextBlock Grid.Column="4" Text="（可留空，表示只在开始时提醒一次）"
                       Foreground="#6F8CA6" FontSize="9" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource Action}" Click="OnCancel"/>
            <Button x:Name="OkButton" Content="确定" Style="{StaticResource Primary}" Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>
