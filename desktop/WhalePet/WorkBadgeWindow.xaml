<Window x:Class="WhalePet.WorkBadgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="搬砖提示"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        IsHitTestVisible="True">
    <Border x:Name="Badge"
            MaxWidth="200"
            Padding="8,6"
            CornerRadius="9"
            Background="#F2FFF8EA"
            BorderBrush="#668FD3FF"
            BorderThickness="1"
            RenderTransformOrigin="0,0.5">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="BadgeScale" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="BadgeText"
                       Text="搬砖中..."
                       Foreground="#0B1B3A"
                       FontSize="10"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </ScrollViewer>
    </Border>
</Window>
