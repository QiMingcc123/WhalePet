<Window x:Class="WhalePet.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="380"
        Height="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI">
    <Border Background="#FF07182E" BorderBrush="#558FD3FF" BorderThickness="1" CornerRadius="12">
        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="PromptText" FontSize="14" FontWeight="Bold" Foreground="#F3FAFF"/>
            <TextBox x:Name="ValueBox" Grid.Row="1" Height="32" Margin="0,10,0,0"
                     Background="#0F8FD3FF" Foreground="#EAF6FF" BorderBrush="#3D8FD3FF"
                     BorderThickness="1" Padding="7,4" TextChanged="OnValueChanged"/>
            <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#FF9A9A" FontSize="10"
                       Margin="0,6,0,0" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Margin="0,8,0,0">
                <Button Content="取消" Width="68" Height="28" Margin="0,0,8,0"
                        Background="#1F8FD3FF" Foreground="#DFF2FF" BorderBrush="#5A8FD3FF"
                        BorderThickness="1" Click="OnCancelClick"/>
                <Button Content="确定" Width="68" Height="28"
                        Background="#4D6BFE" Foreground="#FFFFFF" BorderBrush="#7E93FF"
                        BorderThickness="1" Click="OnOkClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
