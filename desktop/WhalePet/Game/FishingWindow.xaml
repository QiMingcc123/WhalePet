<Window x:Class="WhalePet.Game.FishingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="钓鱼"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        Focusable="True"
        FontFamily="Microsoft YaHei UI"
        Loaded="OnLoaded"
        KeyDown="OnKeyDown"
        Closing="OnClosing"
        Closed="OnClosed">
    <Window.Resources>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#1F8FD3FF"/>
            <Setter Property="Foreground" Value="#DFF2FF"/>
            <Setter Property="BorderBrush" Value="#5A8FD3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#5A8FD3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Choice" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#132C48"/>
            <Setter Property="BorderBrush" Value="#4D8FD3FF"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Exit" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#33FF6B6B"/>
            <Setter Property="BorderBrush" Value="#88FF8A8A"/>
            <Setter Property="Foreground" Value="#FFE1E1"/>
        </Style>
    </Window.Resources>

    <Border x:Name="ScaleRoot" Background="Transparent" CornerRadius="0"
            BorderBrush="Transparent" BorderThickness="0">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="OverlayScale" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <Grid>
            <Border x:Name="SetupCard" Background="#F507182E" BorderBrush="#6B8FD3FF"
                    BorderThickness="1" CornerRadius="12" Padding="16,13" Width="500">
                <StackPanel x:Name="SetupPanel">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#2E8FD3FF" CornerRadius="8" Padding="7,1">
                                <TextBlock Text="钓" FontSize="13" FontWeight="Bold" Foreground="#8FD3FF"/>
                            </Border>
                            <TextBlock Text="钓鱼" FontSize="15" FontWeight="Bold" Foreground="#F3FAFF"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RemainingText" FontSize="10" Foreground="#8FD3FF"
                                       Margin="10,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="选择难度后立即扣除 1 次每日次数，开始后不能中途退出。"
                               FontSize="9.5" Foreground="#9AB6CE" TextWrapping="Wrap" Margin="0,8,0,9"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Choice}" Content="简单" Tag="easy" Click="OnDifficultyClick"/>
                        <Button Style="{StaticResource Choice}" Content="普通" Tag="normal" Click="OnDifficultyClick"/>
                        <Button Style="{StaticResource Choice}" Content="困难" Tag="hard" Click="OnDifficultyClick"/>
                        <Button Style="{StaticResource Choice}" Content="噩梦" Tag="nightmare" Click="OnDifficultyClick"/>
                        <Button Style="{StaticResource Exit}" Content="退出" Click="OnExitSetupClick"/>
                    </StackPanel>
                    <TextBlock x:Name="SetupHint" FontSize="9" Foreground="#6F8CA6" TextWrapping="Wrap"
                               Margin="0,8,0,0" Text="简单 25% 成功区 / 5 秒，普通 20% / 8 秒，困难 15% / 10 秒，噩梦 5% / 15 秒。"/>
                </StackPanel>
            </Border>

            <Grid x:Name="GamePanel" Width="316" Margin="0,4,0,4" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="StatusText" Text="已抛竿，等待鱼儿上钩…" FontSize="11"
                               Foreground="#FFD77A" TextWrapping="Wrap">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="TimerText" Text="60s" FontSize="11" Foreground="#8FD3FF"
                               HorizontalAlignment="Right">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>

                <Canvas x:Name="RingCanvas" Grid.Row="1" Width="280" Height="280" Margin="0,4,0,0"
                        Visibility="Collapsed">
                    <Ellipse Canvas.Left="30" Canvas.Top="30" Width="220" Height="220"
                             Stroke="#B02F6D9E" StrokeThickness="12" Fill="Transparent"/>
                    <Path x:Name="SafeZonePath" Fill="#4D58E0B4" Stroke="#58E0B4" StrokeThickness="1"/>
                    <Ellipse Canvas.Left="80" Canvas.Top="80" Width="120" Height="120"
                             Stroke="#8A1C4C74" StrokeThickness="9" Fill="Transparent"/>
                    <Path x:Name="SuccessArc" Stroke="#58E0B4" StrokeThickness="9"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Ellipse Canvas.Left="136" Canvas.Top="136" Width="8" Height="8" Fill="#8FD3FF"/>
                    <Rectangle x:Name="ProgressMarker" Width="10" Height="18" Fill="#FFB347"
                               RadiusX="2" RadiusY="2" Canvas.Left="135" Canvas.Top="23"
                               RenderTransformOrigin="0.5,0.5"/>
                </Canvas>

                <StackPanel Grid.Row="2" Margin="0,2,0,0">
                    <TextBlock x:Name="ResultText" FontSize="10.5" Foreground="#CFEAFF"
                               TextWrapping="Wrap" TextAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="HintText" FontSize="9" Foreground="#CFEAFF" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,4,0,10"
                               Text="钓鱼进度在成功区内时，圆环内成功进度开始增长；离开成功区会快速下降。">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
